# ESP-IDF Specific (CRITICAL)
# Build directory (contains binaries and temporary files)
build/

# Local configuration files generated by menuconfig
# Note: use sdkconfig.defaults to persist settings in Git
sdkconfig
sdkconfig.old
sdkconfig.temp

# Automatically managed components (like node_modules)
managed_components/
dependencies.lock

# Files generated by the ESP-IDF VS Code extension (contain absolute local paths)
.vscode/c_cpp_properties.json

# Altium Designer
# Local revision history: large regenerated zip blobs, never worth committing
History/
__Previews/
Project Logs for */
*.PrjPcbStructure
*.SchDocPreview
*.PcbDocPreview
*.~(*)
*.$$$
# NOTE: gerbers, STEP and STL exports are NOT ignored on purpose.
# The PCB is never fabricated and the enclosure is printed from this repo,
# so those exports are the hardware deliverable. See docs/HARDWARE_DESIGN.md.

# 3D CAD scratch files
*.f3d.bak
*.blend1
*.blend2

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows (Altium runs on the Windows host, the repo lives in WSL)
Thumbs.db
desktop.ini

# Python (used by Espressif build tools)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.vsix
